---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PostCard from "../components/PostCard.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Banner from "../assets/blog-placeholder-about.jpg";

const GITHUB_AVATAR = "https://github.com/generic-name-2166.png";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 3);

const skills = [
  {
    title: "Frontend",
    detail: "TypeScript, Astro, React, CSS.",
  },
  {
    title: "Backend",
    detail: "Node.js, REST APIs, databases.",
  },
  {
    title: "Tooling",
    detail: "Git, CI/CD, testing, performance.",
  },
  {
    title: "Writing",
    detail: "Technical documentation and blog posts.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 860px;
      }

      /* Profile header */
      .profile {
        border: 1px solid rgb(var(--gray-light));
        border-radius: 16px;
        overflow: hidden;
      }
      .cover {
        display: block;
        line-height: 0;
      }
      .cover img {
        width: 100%;
        height: 240px;
        object-fit: cover;
        display: block;
      }
      .identity {
        padding: 0 2em 2em;
      }
      .avatar {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        object-fit: cover;
        margin-top: -56px;
        border: 4px solid #fff;
        background: #fff;
        box-shadow: var(--box-shadow);
      }
      .identity h1 {
        margin: 0.5em 0 0;
        font-size: 2.441em;
      }
      .role {
        margin: 0;
        color: rgb(var(--gray));
      }
      .about {
        max-width: 60ch;
        color: rgb(var(--gray-dark));
      }

      /* Sections */
      section {
        margin: 2.5em 0;
      }
      section h2 {
        font-size: 1.563em;
        margin-bottom: 1em;
      }

      /* Skills */
      .skills {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        padding: 0;
        list-style: none;
      }
      .skills li {
        padding: 1em 1.25em;
        border: 1px solid rgb(var(--gray-light));
        border-top: 3px solid var(--accent);
        border-radius: 8px;
      }
      .skills h3 {
        margin: 0 0 0.25em;
        font-size: 1em;
      }
      .skills p {
        margin: 0;
        font-size: 0.9em;
        color: rgb(var(--gray-dark));
      }

      /* Latest posts */
      .posts {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      @media (max-width: 720px) {
        .cover img {
          height: 160px;
        }
        .identity {
          padding: 0 1.25em 1.25em;
        }
        .identity h1 {
          font-size: 1.8em;
        }
        .posts {
          gap: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="profile">
        <div class="cover">
          <Image width={960} height={240} src={Banner} alt="" />
        </div>
        <div class="identity">
          <img
            class="avatar"
            src={GITHUB_AVATAR}
            width={112}
            height={112}
            alt="Profile picture"
          />
          <h1>Kirill Bessonov</h1>
          <p class="role">Software Engineer</p>
          <p class="about">
            I build web applications and write about the process. Replace this
            paragraph with a short introduction about yourself.
          </p>
        </div>
      </div>

      <section>
        <h2>What I work with</h2>
        <ul class="skills">
          {
            skills.map((skill) => (
              <li>
                <h3>{skill.title}</h3>
                <p>{skill.detail}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Latest posts</h2>
        <ul class="posts">
          {
            latest.map((post) => (
              <li>
                <PostCard post={post} />
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
